<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude database containing GPS location points to guarantee on-device privacy -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!--
            Privacy: GPS databases and ride location data must NOT be transferred.
            Only user preferences (DataStore/SharedPrefs) are migrated.
            Ride data can be migrated explicitly via the in-app backup/restore flow.
        -->
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
